{
  "expo": {
    "name": "GP",
    "slug": "gp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gp",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FEFDFF",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.rujul.gp",
      "supportsTablet": false
    },
    "android": {
      "package": "com.rujul.gp",
      "adaptiveIcon": {
        "backgroundColor": "#FEFDFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEFDFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "GP uses the camera to scan your body measurements and take photos for the Trial Room.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GP uses your photos for your profile picture and the Trial Room.",
          "cameraPermission": "GP uses the camera to take your profile and Trial Room photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d02ae2d7-c8b5-4fce-aede-f985607cc671"
      }
    },
    "owner": "joojuice"
  }
}
